
#include <iostream>
#include <string>
#include <vector>
#include <queue>
#include <fstream>
#include <limits>
#include <algorithm>

using namespace std;

// ==========================================
// COMMON DATA STRUCTURES
// ==========================================

struct Review {
    int reviewId;
    int buildingId;
    int locationId;
    int severity;
    string category;
    string description;
    bool verified;
};

struct Location {
    int locationId;
    string name;
    int floor;
};

struct Connection {
    int connectionId;
    int fromLocationId;
    int toLocationId;
    float distance;
    bool available;
    bool hasStairs;
};

// ==========================================
// 1. REVIEW LINKED LIST
// ==========================================

struct ReviewNode {
    Review data;
    ReviewNode* next;

    ReviewNode(Review r) {
        data = r;
        next = nullptr;
    }
};

class ReviewManager {
private:
    ReviewNode* head;

public:
    ReviewManager() {
        head = nullptr;
    }

    ~ReviewManager() {
        clear();
    }

    void clear() {
        while (head != nullptr) {
            ReviewNode* temp = head;
            head = head->next;
            delete temp;
        }
    }

    bool reviewExists(int id) const {
        ReviewNode* temp = head;

        while (temp != nullptr) {
            if (temp->data.reviewId == id)
                return true;

            temp = temp->next;
        }

        return false;
    }

    void addReview(Review r) {
        if (reviewExists(r.reviewId)) {
            cout << "Review ID already exists.\n";
            return;
        }

        ReviewNode* newNode = new ReviewNode(r);

        if (head == nullptr) {
            head = newNode;
            return;
        }

        ReviewNode* temp = head;

        while (temp->next != nullptr)
            temp = temp->next;

        temp->next = newNode;
    }

    void displayReviews() const {
        if (head == nullptr) {
            cout << "\nNo reviews found.\n";
            return;
        }

        ReviewNode* temp = head;

        cout << "\n========== REVIEWS ==========\n";

        while (temp != nullptr) {
            Review r = temp->data;

            cout << "\nReview ID: " << r.reviewId;
            cout << "\nBuilding ID: " << r.buildingId;
            cout << "\nLocation ID: " << r.locationId;
            cout << "\nCategory: " << r.category;
            cout << "\nSeverity: " << r.severity;
            cout << "\nDescription: " << r.description;
            cout << "\nVerified: "
                 << (r.verified ? "Yes" : "No");
            cout << "\n-----------------------------\n";

            temp = temp->next;
        }
    }

    bool verifyReview(int id) {
        ReviewNode* temp = head;

        while (temp != nullptr) {
            if (temp->data.reviewId == id) {
                temp->data.verified = true;
                return true;
            }

            temp = temp->next;
        }

        return false;
    }

    vector<Review> getReviews(int buildingId) const {
        vector<Review> result;

        ReviewNode* temp = head;

        while (temp != nullptr) {
            if (temp->data.buildingId == buildingId)
                result.push_back(temp->data);

            temp = temp->next;
        }

        return result;
    }

    void saveToFile() const {
        ofstream file("reviews.txt");

        if (!file) {
            cout << "Unable to save file.\n";
            return;
        }

        ReviewNode* temp = head;

        while (temp != nullptr) {
            Review r = temp->data;

            file << r.reviewId << "|"
                 << r.buildingId << "|"
                 << r.locationId << "|"
                 << r.severity << "|"
                 << r.category << "|"
                 << r.description << "|"
                 << r.verified << "\n";

            temp = temp->next;
        }

        file.close();
    }

    void loadFromFile() {
        ifstream file("reviews.txt");

        if (!file)
            return;

        clear();

        string line;

        while (getline(file, line)) {
            vector<string> fields;
            string current;

            for (char ch : line) {
                if (ch == '|') {
                    fields.push_back(current);
                    current.clear();
                } else {
                    current += ch;
                }
            }

            fields.push_back(current);

            if (fields.size() != 7)
                continue;

            try {
                Review r;

                r.reviewId = stoi(fields[0]);
                r.buildingId = stoi(fields[1]);
                r.locationId = stoi(fields[2]);
                r.severity = stoi(fields[3]);
                r.category = fields[4];
                r.description = fields[5];
                r.verified = (fields[6] == "1");

                addReview(r);
            }
            catch (...) {
                cout << "Skipping invalid review record.\n";
            }
        }

        file.close();
    }
};

// ==========================================
// 2. REVIEW OPTIMIZATION
// ==========================================

struct ProblemSummary {
    int locationId;
    int reviewCount;
    int verifiedCount;
    int severityTotal;
    int priorityScore;
};

class MaxHeap {
private:
    vector<ProblemSummary> heap;

    bool higherPriority(
        ProblemSummary a,
        ProblemSummary b
    ) {
        if (a.priorityScore != b.priorityScore)
            return a.priorityScore > b.priorityScore;

        return a.locationId < b.locationId;
    }

    void heapifyUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2;

            if (higherPriority(heap[i], heap[parent])) {
                swap(heap[i], heap[parent]);
                i = parent;
            } else {
                break;
            }
        }
    }

    void heapifyDown(int i) {
        int n = heap.size();

        while (true) {
            int left = 2 * i + 1;
            int right = 2 * i + 2;
            int largest = i;

            if (left < n &&
                higherPriority(heap[left], heap[largest]))
                largest = left;

            if (right < n &&
                higherPriority(heap[right], heap[largest]))
                largest = right;

            if (largest == i)
                break;

            swap(heap[i], heap[largest]);
            i = largest;
        }
    }

public:
    void push(ProblemSummary p) {
        heap.push_back(p);
        heapifyUp(heap.size() - 1);
    }

    bool empty() const {
        return heap.empty();
    }

    ProblemSummary pop() {
        ProblemSummary result = heap[0];

        heap[0] = heap.back();
        heap.pop_back();

        if (!heap.empty())
            heapifyDown(0);

        return result;
    }
};

class ReviewOptimizer {
public:
    void generateRanking(
        const vector<Review>& reviews,
        int buildingId
    ) {
        vector<ProblemSummary> summaries;

        for (const Review& r : reviews) {
            if (r.buildingId != buildingId)
                continue;

            int index = -1;

            for (int i = 0; i < (int)summaries.size(); i++) {
                if (summaries[i].locationId == r.locationId) {
                    index = i;
                    break;
                }
            }

            if (index == -1) {
                ProblemSummary p;

                p.locationId = r.locationId;
                p.reviewCount = 0;
                p.verifiedCount = 0;
                p.severityTotal = 0;
                p.priorityScore = 0;

                summaries.push_back(p);
                index = summaries.size() - 1;
            }

            summaries[index].reviewCount++;

            if (r.verified) {
                summaries[index].verifiedCount++;
                summaries[index].severityTotal += r.severity;
            }
        }

        MaxHeap maxHeap;

        for (ProblemSummary& p : summaries) {
            if (p.verifiedCount > 0) {
                p.priorityScore =
                    p.severityTotal + 2 * (p.verifiedCount - 1);
            }

            maxHeap.push(p);
        }

        cout << "\n======= PRIORITY RANKING =======\n";

        if (summaries.empty()) {
            cout << "No reviews available.\n";
            return;
        }

        while (!maxHeap.empty()) {
            ProblemSummary p = maxHeap.pop();

            cout << "\nLocation ID: " << p.locationId;
            cout << "\nTotal reviews: " << p.reviewCount;
            cout << "\nVerified reviews: " << p.verifiedCount;
            cout << "\nPriority score: " << p.priorityScore;

            if (p.verifiedCount == 0)
                cout << "\nStatus: Awaiting verification";
            else if (p.priorityScore >= 10)
                cout << "\nStatus: High priority";
            else if (p.priorityScore >= 5)
                cout << "\nStatus: Needs attention";
            else
                cout << "\nStatus: Monitor";

            cout << "\n-----------------------------\n";
        }
    }
};

// ==========================================
// 3. BUILDING GRAPH
// ==========================================

struct BuildingData {
    vector<Location> locations;
    vector<Connection> connections;
};

class Graph {
private:
    vector<Location> locations;
    vector<Connection> connections;

    int findLocation(int id) const {
        for (int i = 0; i < (int)locations.size(); i++) {
            if (locations[i].locationId == id)
                return i;
        }

        return -1;
    }

public:
    Graph() {}

    Graph(const BuildingData& data) {
        locations = data.locations;
        connections = data.connections;
    }

    void blockConnection(int id) {
        for (Connection& c : connections) {
            if (c.connectionId == id) {
                c.available = false;
                return;
            }
        }

        cout << "Connection not found.\n";
    }

    void restoreConnection(int id) {
        for (Connection& c : connections) {
            if (c.connectionId == id) {
                c.available = true;
                return;
            }
        }

        cout << "Connection not found.\n";
    }

    void disableFacility(int locationId) {
        bool found = false;

        for (Connection& c : connections) {
            if (c.fromLocationId == locationId ||
                c.toLocationId == locationId) {
                c.available = false;
                found = true;
            }
        }

        if (!found)
            cout << "No connections found for this facility.\n";
    }

    int countReachable(int startId, bool wheelchair) const {
        int start = findLocation(startId);

        if (start == -1)
            return 0;

        vector<bool> visited(locations.size(), false);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        int count = 0;

        while (!q.empty()) {
            int current = q.front();
            q.pop();

            count++;

            int currentId = locations[current].locationId;

            for (const Connection& c : connections) {
                if (c.fromLocationId != currentId)
                    continue;

                if (!c.available)
                    continue;

                if (wheelchair && c.hasStairs)
                    continue;

                int next = findLocation(c.toLocationId);

                if (next != -1 && !visited[next]) {
                    visited[next] = true;
                    q.push(next);
                }
            }
        }

        return count;
    }

    void displayConnections() const {
        for (const Connection& c : connections) {
            cout << c.connectionId << ": "
                 << c.fromLocationId << " -> "
                 << c.toLocationId
                 << " | Available: "
                 << (c.available ? "Yes" : "No")
                 << "\n";
        }
    }
};

// ==========================================
// 4. WHAT-IF SIMULATOR
// ==========================================

class WhatIfSimulator {
private:
    Graph originalGraph;
    Graph scenarioGraph;

public:
    WhatIfSimulator(const BuildingData& data)
        : originalGraph(data), scenarioGraph(data) {}

    void reset() {
        scenarioGraph = originalGraph;
    }

    void blockConnection(int id) {
        scenarioGraph.blockConnection(id);
        cout << "Scenario: connection blocked.\n";
    }

    void restoreConnection(int id) {
        scenarioGraph.restoreConnection(id);
        cout << "Scenario: connection restored.\n";
    }

    void disableFacility(int id) {
        scenarioGraph.disableFacility(id);
        cout << "Scenario: facility disabled.\n";
    }

    void compare(int startId, bool wheelchair) const {
        int before =
            originalGraph.countReachable(startId, wheelchair);

        int after =
            scenarioGraph.countReachable(startId, wheelchair);

        cout << "\n======= ACCESSIBILITY COMPARISON =======\n";

        cout << "Before: " << before << " reachable locations\n";
        cout << "After: " << after << " reachable locations\n";
        cout << "Difference: " << after - before << "\n";

        if (after < before)
            cout << "Accessibility has decreased.\n";
        else if (after > before)
            cout << "Accessibility has improved.\n";
        else
            cout << "No change in reachability.\n";
    }

    void displayScenario() const {
        scenarioGraph.displayConnections();
    }
};

// ==========================================
// 5. SAMPLE BUILDING
// ==========================================

BuildingData createSampleBuilding() {
    BuildingData data;

    data.locations = {
        {1, "Main Entrance", 0},
        {2, "Main Corridor", 0},
        {3, "Elevator", 0},
        {4, "Room 101", 0},
        {5, "Staircase", 0},
        {6, "First Floor Corridor", 1},
        {7, "Room 201", 1},
        {8, "Emergency Exit", 0}
    };

    data.connections = {
        {1, 1, 2, 10, true, false},
        {2, 2, 3, 5, true, false},
        {3, 3, 6, 8, true, false},
        {4, 6, 7, 6, true, false},
        {5, 2, 5, 4, true, true},
        {6, 5, 6, 9, true, true},
        {7, 2, 8, 12, true, false}
    };

    return data;
}

// ==========================================
// 6. SAMPLE REVIEWS
// ==========================================

void addSampleReviews(ReviewManager& manager) {
    manager.addReview({
        1, 1, 5, 5,
        "Steep ramp",
        "Ramp is difficult for wheelchair users.",
        true
    });

    manager.addReview({
        2, 1, 3, 4,
        "Elevator failure",
        "Elevator stopped working repeatedly.",
        true
    });

    manager.addReview({
        3, 1, 5, 3,
        "Difficult ramp access",
        "Ramp entrance is difficult to access.",
        true
    });

    manager.addReview({
        4, 1, 2, 5,
        "Blocked corridor",
        "Corridor is frequently blocked.",
        true
    });

    manager.addReview({
        5, 1, 3, 5,
        "Frequent breakdown",
        "Elevator frequently becomes unavailable.",
        true
    });

    manager.addReview({
        6, 1, 7, 4,
        "Door accessibility",
        "Door is difficult to open.",
        false
    });
}

// ==========================================
// 7. MAIN MENU
// ==========================================

int main() {
    ReviewManager manager;
    ReviewOptimizer optimizer;

    BuildingData building = createSampleBuilding();

    WhatIfSimulator simulator(building);

    manager.loadFromFile();

    if (manager.getReviews(1).empty()) {
        addSampleReviews(manager);
        manager.saveToFile();
    }

    int choice;

    do {
        cout << "\n========== ACCESSPULSE - MEMBER 3 ==========\n";
        cout << "1. Add review\n";
        cout << "2. Display reviews\n";
        cout << "3. Verify a review\n";
        cout << "4. Generate priority ranking\n";
        cout << "5. Block a connection\n";
        cout << "6. Disable elevator\n";
        cout << "7. Compare accessibility\n";
        cout << "8. Display scenario\n";
        cout << "9. Reset scenario\n";
        cout << "0. Exit\n";

        cout << "\nEnter choice: ";

        if (!(cin >> choice)) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input.\n";
            continue;
        }

        if (choice == 1) {
            Review r;

            cout << "Review ID: ";
            cin >> r.reviewId;

            if (manager.reviewExists(r.reviewId)) {
                cout << "Review ID already exists.\n";
                continue;
            }

            r.buildingId = 1;

            cout << "Location ID: ";
            cin >> r.locationId;

            cout << "Severity (1-5): ";
            cin >> r.severity;

            if (r.severity < 1 || r.severity > 5) {
                cout << "Invalid severity.\n";
                continue;
            }

            cin.ignore(
                numeric_limits<streamsize>::max(), '\n'
            );

            cout << "Category: ";
            getline(cin, r.category);

            cout << "Description: ";
            getline(cin, r.description);

            r.verified = false;

            manager.addReview(r);
            manager.saveToFile();

            cout << "Review submitted and awaiting verification.\n";
        }

        else if (choice == 2) {
            manager.displayReviews();
        }

        else if (choice == 3) {
            int id;

            cout << "Enter review ID to verify: ";
            cin >> id;

            if (manager.verifyReview(id)) {
                manager.saveToFile();
                cout << "Review verified.\n";
            } else {
                cout << "Review not found.\n";
            }
        }

        else if (choice == 4) {
            optimizer.generateRanking(
                manager.getReviews(1), 1
            );
        }

        else if (choice == 5) {
            int id;

            cout << "Enter connection ID to block: ";
            cin >> id;

            simulator.blockConnection(id);
        }

        else if (choice == 6) {
            simulator.disableFacility(3);
        }

        else if (choice == 7) {
            simulator.compare(1, true);
        }

        else if (choice == 8) {
            simulator.displayScenario();
        }

        else if (choice == 9) {
            simulator.reset();
            cout << "Scenario reset successfully.\n";
        }

        else if (choice != 0) {
            cout << "Invalid choice.\n";
        }

    } while (choice != 0);

    manager.saveToFile();

    cout << "AccessPulse Member 3 closed.\n";

    return 0;
}
